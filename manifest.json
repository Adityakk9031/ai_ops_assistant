    "architecture": {
        "agents": [
            {
                "name": "Planner",
                "prompt_file": "llm/prompts/planner_prompt.json",
                "responsibility": "Create structured execution plans from user tasks"
            },
            {
                "name": "Executor",
                "prompt_file": "llm/prompts/executor_prompt.json",
                "responsibility": "Execute plan steps using available tools"
            },
            {
                "name": "Verifier",
                "prompt_file": "llm/prompts/verifier_prompt.json",
                "responsibility": "Validate results and assemble final output"
            }
        ],
        "tools": [
            {
                "name": "GitHubTool",
                "api": "GitHub REST API v3",
                "operations": [
                    "search_repos",
                    "get_repo",
                    "get_repos_batch"
                ]
            },
            {
                "name": "WeatherTool",
                "api": "OpenWeatherMap API",
                "operations": [
                    "current_weather",
                    "forecast"
                ]
            },
            {
                "name": "NewsTool",
                "api": "NewsAPI",
                "operations": [
                    "search_news",
                    "top_headlines"
                ]
            }
        ]
    },
    "setup_commands": [
        "cd ai_ops_assistant",
        "python -m venv venv",
        "source venv/bin/activate  # On Windows: venv\\Scripts\\activate",
        "pip install -r requirements.txt",
        "cp .env.example .env",
        "# Edit .env with your API keys",
        "python main.py  # Or: uvicorn main:app --reload --port 8000"
    ],
    "demo_commands": [
        {
            "description": "GitHub repository search",
            "command": "curl -X POST http://localhost:8000/api/submit -H \"Content-Type: application/json\" -d '{\"task\":\"Find top 3 Python web frameworks on GitHub with > 5k stars\"}'"
        },
        {
            "description": "Weather query",
            "command": "curl -X POST http://localhost:8000/api/submit -H \"Content-Type: application/json\" -d '{\"task\":\"Get current weather in Bangalore\"}'"
        },
        {
            "description": "Multi-tool task",
            "command": "curl -X POST http://localhost:8000/api/submit -H \"Content-Type: application/json\" -d '{\"task\":\"Find top 3 Python web frameworks on GitHub and weather in Bangalore, then create a summary\"}'"
        }
    ],
    "test_commands": [
        "pytest tests/ -v",
        "pytest tests/test_planner.py -v",
        "pytest tests/test_executor.py -v",
        "pytest tests/test_verifier.py -v",
        "pytest tests/test_integration.py -v -s"
    ],
    "key_features": [
        "Strict agent separation with dedicated prompt files",
        "JSON schema validation using Pydantic",
        "Automatic retry with exponential backoff",
        "Real third-party API integrations (GitHub, OpenWeatherMap, NewsAPI)",
        "Comprehensive error handling and logging",
        "Complete test coverage with unit and integration tests",
        "RESTful API with FastAPI",
        "Confidence scoring and result verification",
        "Automatic re-execution of failed steps"
    ],
    "environment_variables": {
        "required": [
            "GEMINI_API_KEY"
        ],
        "recommended": [
            "GITHUB_TOKEN",
            "OPENWEATHER_KEY"
        ],
        "optional": [
            "NEWSAPI_KEY",
            "PORT"
        ]
    }
}