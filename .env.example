# ─────────────────────────────────────────────────────────────
# AI Operations Assistant — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env
# NEVER commit your .env file to version control!
# ─────────────────────────────────────────────────────────────

# ── Google Gemini (Required) ──────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for planning and verification
# Available: gemini-3.5-flash | gemini-2.5-flash | gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash

# ── Pinecone Vector DB (Required for Memory) ──────────────────
# Sign up free at: https://app.pinecone.io
# Create a Serverless index with dimension=768, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-ops-memory

# ── GitHub (Highly Recommended) ───────────────────────────────
# Get a token at: https://github.com/settings/tokens
# Use "Generate new token (classic)" → select public_repo scope
# Without token: 60 requests/hour. With token: 5,000 requests/hour.
GITHUB_TOKEN=your_github_token_here

# ── OpenWeatherMap (Required for Weather tasks) ────────────────
# Sign up free at: https://home.openweathermap.org/users/sign_up
# Then get your key at: https://home.openweathermap.org/api_keys
OPENWEATHER_KEY=your_openweathermap_key_here

# ── NewsAPI (Required for News tasks) ─────────────────────────
# Register free at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ── Server Configuration ──────────────────────────────────────
PORT=8000
